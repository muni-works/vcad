; Racing-plasmoid dish with its plasma as glowing media — the glow demo for
; the photoreal path tracer (docs/glow/README.md).
;
; The device geometry is docs/plasmoid-sim/plasmoid-dish.loon (PR #1198),
; copied so this file stands alone: Z-up, millimetres, the dish's inner
; surface at z = 0, glow sheet at z = +2. The magnet is at its HOLD pose
; (r = 55 mm, 120°, 10 mm air gap) and the filament runs from the spike tip
; to the foot under it.
;
; The plasma is three `material-glow` media — volumes with no surface, whose
; emission the path tracer integrates along every ray (camera and bounce):
;   filament  a lofted tube, spike tip → foot, thickening toward the foot
;   foot      the bright knot where the filament meets the glow sheet
;   sheet     the faint diffuse disc glow over the whole dish
; Its shape is stylised exactly as in the old docs/plasmoid-sim/render.py,
; now `vcad-render --sim plasmoid` (crates/vcad-render/src/plasmoid.rs) (the
; reduced model has no filament geometry); its *rendering* is not.

[let dish-r 85]
[let dish-depth 14]

[let dish
  [revolve 0 0 0  0 0 1  360
    [sketch 0 0 0  1 0 0  0 0 1
      #[[polygon #[30 [- 0 dish-depth 2]  52 [- 0 dish-depth 2]  [+ dish-r 2] 0
                   dish-r 0  50 [- 0 dish-depth]  30 [- 0 dish-depth]]]]]]]

[let spike [pipe [cone 7 0.6 24] [translate 0 0 [- 0 dish-depth]]]]
[let coil   [pipe [cylinder 46 34] [translate 0 0 -52]]]
[let puck-1 [pipe [cylinder 56 16] [translate 0 0 -70]]]
[let puck-2 [pipe [cylinder 62 18] [translate 0 0 -90]]]
[let ring [pipe [torus 112 2.5] [translate 0 0 95]]]
[let post [fn [ang]
  [pipe [cylinder 2 110]
        [translate [* 112 [cos [* ang 0.0174533]]] [* 112 [sin [* ang 0.0174533]]] -15]]]]

[let mx [* 55 [cos [* 120 0.0174533]]]]
[let my [* 55 [sin [* 120 0.0174533]]]]
[let disc [cylinder 5 5]]
[let holder [pipe [cylinder 2 60] [translate 0 0 5]]]
[let magnet [pipe [union disc holder] [translate mx my 10]]]

; ── the plasma ───────────────────────────────────────────────────────────
; Filament centreline: straight from the spike tip (0, 0, 10) to the foot
; (mx, my, 2), lifted by the same arch `--sim plasmoid` draws.
[let tip-z [+ [- 0 dish-depth] 24]]
[let pi 3.14159265]
[let fil-x [fn [s] [* mx s]]]
[let fil-y [fn [s] [* my s]]]
[let fil-z [fn [s]
  [+ [* tip-z [- 1 s]] [* 2 s]
     [* 9 [sin [* pi s]] [- 1 s]] [* 3 [sin [* pi s]]]]]]
[let fil-r [fn [s] [+ 0.7 [* 1.1 s]]]]

; One ring of the tube at parameter s: a 14-gon in the plane through the
; centreline point spanned by the horizontal side vector (perpendicular to
; the filament's plan direction) and world Z — near enough normal to the
; tangent for a tube this gently curved.
[let plan-len [sqrt [+ [* mx mx] [* my my]]]]
[let sx [/ [- 0 my] plan-len]]
[let sy [/ mx plan-len]]
[let ring-at [fn [s]
  [let r [fil-r s]
    [sketch [fil-x s] [fil-y s] [fil-z s]  sx sy 0  0 0 1
      #[[polygon [flat-map [fn [k]
                   [let a [* k [/ [* 2 pi] 14]]
                     #[[* r [cos a]] [* r [sin a]]]]]
                 [range 0 14]]]]]]]]
[let filament [loft [map [fn [k] [ring-at [* k 0.1]]] [range 0 11]]]]

[let foot [pipe [sphere 4] [translate mx my 2]]]
[let sheet [pipe [cylinder 82 2] [translate 0 0 1]]]

; Linear orange of the argon glow; intensity is radiance per mm of path.
[material-glow "plasma-core" 1.0 0.42 0.14 14.0 0 0.6]
[material-glow "plasma-foot" 1.0 0.45 0.16 5.0 0 3.0]
[material-glow "plasma-sheet" 1.0 0.40 0.14 0.02 0 0.9]

[root dish "copper"]
[root spike "glass"]
[root coil "plastic"]
[root puck-1 "aluminum"]
[root puck-2 "aluminum"]
[root ring "copper"]
[root [union [post 60] [post 120] [post 200] [post 340]] "plastic"]
[root magnet "steel"]
[root filament "plasma-core"]
[root foot "plasma-foot"]
[root sheet "plasma-sheet"]
