; Racing-plasmoid dish — the live demo document for docs/plasmoid-sim.md.
;
; Geometry lives in plasmoid-device.loon. The magnet is drawn at its HOLD
; pose (r = 55 mm, 120°, 10 mm air gap). vcad.app's live demo (Analysis ▸
; Live Plasmoid, apple/VcadApp/.../PlasmoidSim.swift) binds to the roots
; named `dish`, `spike` and `magnet`; plasmoid-dish.vcad is this file
; through loon2vcad (regenerate both together).
;
; The rendered clip is plasmoid-clip.loon: the same device plus the plasma
; media and the magnet choreography as the document timeline.

[use plasmoid-device [dish-of spike-of coil puck-1 puck-2 ring posts magnet-of]]

[let dish [dish-of 85 14]]
[let spike [spike-of 14]]

; N52 10 x 5 mm disc, north pole down, 10 mm above the dish, on a holder.
; Disc and holder are ONE root named `magnet` so dragging it in vcad.app
; moves the wand as a whole; the live plasmoid demo (PlasmoidSim.swift)
; reads the disc as the bottom 5 mm of that part's bounding box.
[let magnet [magnet-of [* 55 [cos [* 120 0.0174533]]] [* 55 [sin [* 120 0.0174533]]] 10 5 5]]

[root dish "copper"]
[root spike "glass"]
[root coil "plastic"]
[root puck-1 "aluminum"]
[root puck-2 "aluminum"]
[root ring "copper"]
[root posts "plastic"]
[root magnet "steel"]
