; open fusor — machine CAD for docs/videos/open-fusor.md, second pass.
;
; Built from stock vacuum hardware (`std:vacuum.*`, ISO 3669 / ISO 2861
; vendor tables) joined by port mates, so every joint also lands its
; consumables (copper gasket + bolt set, or KF ring + clamp) on the BOM.
; Z up, origin at the chamber center, millimetres.
;
;   chamber   DN63 (4.5" CF) spherical cube. cavity radius 79.9 mm
;   +z        DN63→DN40 zero-length reducer → 40 kV HV feedthrough; its
;             conductor is the grid stalk, sleeved in alumina
;   +y        DN63 viewport, leaded glass (the x-ray leak path, see plan §4)
;   -y        DN63 viewport, leaded glass (camera side)
;   -z        DN63→DN40 reducer → CF/KF40 adapter → turbo + roughing line
;   +x        DN63→DN40 reducer → DN40 tee: KF25 gauge on the run,
;             DN40→DN16 reducer + leak valve (D2 inlet) on the branch
;   -x        DN63 blank (spare port)
;   cathode   6 great circles of 2 mm wire on a 19 mm sphere, the
;             icosidodecahedral layout of
;             vcad_kernel_particle::wire3d::GreatCircleLayout::Icosidodecahedral6
;
; What the simulations assume vs this file:
;   - the 3D thin-wire BEM (`globe_vs_rings`) uses THIS grid in a 76 mm
;     spherical chamber. the catalog cavity is 79.9 mm (+5%).
;   - the two-sided yield band (`open_fusor_band`) uses a 4-ring latitude
;     stack in a 76 mm cylinder. fusor-sim.loon draws that device. neither
;     file goes through `vcad_eval::sim_extract` as written: this one has a
;     spherical cavity and crossing wires, that one has a section cut and a
;     stalk on the rings. the extraction is tested on a clean can + rings of
;     the same dimensions (crates/vcad-eval/tests/sim_extract_fusor.rs).
;   - the photon-dose case (docs/photon-dose-m0.md) is a 1.65 mm wall sphere
;     with a 2.75" window of 19 mm clear radius under 8 mm of lead glass.
;     this cube's wall is 11 mm or more, its DN63 windows have 32.5 mm clear
;     radius, and the catalog models 5.2 mm of glass. not re-priced.
;
; Dressing files, appended for renders only:
;   castle.loon     15 cm HDPE shield (plan §4), hides the machine
;   star-mode.loon  glowing core + halo, illustrative

; --- parameters -------------------------------------------------------------
[let grid-r 19.0]
[let wire-r 1.0]
[let tilt 31.717474]        ; atan(1/phi): 5-fold axis off the coordinate axis
[let stalk-len "89"]        ; HV seal face is 108.73 mm up; tip lands on the grid pole

[material "grid" 0.95 0.55 0.20 0.8 0.4]
[material "alumina" 0.93 0.91 0.86 0.0 0.6]

; --- vacuum hardware --------------------------------------------------------
[let chamber [vac "vacuum.chamber.spherical-cube" #["size" "DN63"]]]

[let hv-red [vac-mate "vacuum.cf.reducer" #["large" "DN63" "small" "DN40"] "large" chamber "+z"]]
[let hv [vac-mate "vacuum.feedthrough.hv"
          #["size" "DN40" "rated_kv" "40" "rated_a" "0.02" "vacuum_length" stalk-len "conductor_dia" "3.2"]
          "seal" hv-red "small"]]

[let window-front [vac-mate "vacuum.viewport" #["size" "DN63" "glass" "leaded-glass"] "seal" chamber "-y"]]
[let window-back  [vac-mate "vacuum.viewport" #["size" "DN63" "glass" "leaded-glass"] "seal" chamber "+y"]]
[let blank [vac-mate "vacuum.cf.flange" #["size" "DN63"] "seal" chamber "-x"]]

[let pump-red [vac-mate "vacuum.cf.reducer" #["large" "DN63" "small" "DN40"] "large" chamber "-z"]]
[let pump [vac-mate "vacuum.adapter.cf-kf" #["cf" "DN40" "kf" "KF40" "length" "60"] "cf" pump-red "small"]]

[let side-red [vac-mate "vacuum.cf.reducer" #["large" "DN63" "small" "DN40"] "large" chamber "+x"]]
[let tee [vac-mate "vacuum.tee" #["size" "DN40"] "-z" side-red "small"]]
[let gauge-ad [vac-mate "vacuum.adapter.cf-kf" #["cf" "DN40" "kf" "KF25" "length" "40"] "cf" tee "+z"]]
[let gauge [vac-mate "vacuum.gauge" #["size" "KF25" "kind" "pirani"] "inlet" gauge-ad "kf"]]
[let gas-red [vac-mate "vacuum.cf.reducer" #["large" "DN40" "small" "DN16"] "large" tee "+x"]]
[let leak [vac-mate "vacuum.valve.needle" #["size" "DN16" "kind" "leak"] "outlet" gas-red "small"]]

; one root per purchased part: no unions between parts, so nothing is
; booleaned that a wrench would not also join.
[root-named chamber "stainless" "chamber"]
[root-named hv-red "stainless" "hv-reducer"]
[root-named hv "ceramic" "hv-feedthrough"]
[root-named window-front "glass" "viewport-front"]
[root-named window-back "glass" "viewport-back"]
[root-named blank "stainless" "blank"]
[root-named pump-red "stainless" "pump-reducer"]
[root-named pump "stainless" "pump-adapter"]
[root-named side-red "stainless" "side-reducer"]
[root-named tee "stainless" "tee"]
[root-named gauge-ad "stainless" "gauge-adapter"]
[root-named gauge "aluminum" "gauge"]
[root-named gas-red "stainless" "gas-reducer"]
[root-named leak "steel" "leak-valve"]

; --- stalk sleeve -----------------------------------------------------------
; alumina tube over the conductor from the grid pole up into the top bore,
; so ions land on ceramic, not on the stalk.
[root-named
  [translate 0.0 0.0 24.0 [difference [cylinder 1.7 46.0] [cylinder 4.0 46.0]]]
  "alumina" "stalk-sleeve"]

; --- cathode grid -----------------------------------------------------------
; six great circles, plane normals along the icosahedron's 5-fold axes:
; (0, 1, +-phi), (1, +-phi, 0), (+-phi, 0, 1). every rotation is about one
; axis, so the Euler order never matters. each circle is its own root: the
; wires are spot-welded at the crossings, not fused into one body.
[let loop [torus grid-r wire-r]]
[root-named [rotate tilt 0.0 0.0 loop] "grid" "grid-1"]
[root-named [rotate [- 0.0 tilt] 0.0 0.0 loop] "grid" "grid-2"]
[root-named [rotate 0.0 0.0 tilt [rotate 90.0 0.0 0.0 loop]] "grid" "grid-3"]
[root-named [rotate 0.0 0.0 [- 0.0 tilt] [rotate 90.0 0.0 0.0 loop]] "grid" "grid-4"]
[root-named [rotate 0.0 [- 90.0 tilt] 0.0 loop] "grid" "grid-5"]
[root-named [rotate 0.0 [- tilt 90.0] 0.0 loop] "grid" "grid-6"]
