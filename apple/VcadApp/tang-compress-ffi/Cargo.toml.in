# Template: build-tc-ffi.sh fills @TC@ with the tang-compress checkout and
# builds this outside the vcad workspace (vcad's ../tang symlink points at the
# main tang checkout, which need not carry tang-compress).
[package]
name = "tang-compress-ffi"
version = "0.1.0"
edition = "2021"
publish = false

[lib]
crate-type = ["staticlib"]
path = "@SRC@/lib.rs"

[dependencies]
cram-codec = { path = "@TC@/crates/cram-codec", default-features = false }

[profile.release]
debug = false
# MUST match libvcad_ffi.a's "unwind": both staticlibs carry a copy of Rust's
# std and define the same panic-runtime symbols, and the linker keeps one. With
# "abort" here, vcad.app could link the abort runtime, and then every kernel
# panic (which vcad-eval's catch_unwind turns into a per-part failure) killed
# the whole app instead (SIGABRT opening fusor.loon).
panic = "unwind"

[workspace]
