# PostHog Analytics (optional)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Supabase (optional) — only the /export page uses it, to sign in and read
# the user's documents. Defaults to the production project's publishable key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Retired-route redirects: on in production builds, off in dev. 1/0 overrides.
VITE_VCAD_RETIREMENT_REDIRECTS=
